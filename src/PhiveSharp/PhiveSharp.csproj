<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PhiveSharp</RootNamespace>
    <AssemblyName>PhiveSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Reader and writer for Phive, the Havok physics container used by Tears of the Kingdom, and the static compound bodies it holds.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

</Project>
